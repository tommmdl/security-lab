            {
              "id": "CVE-2026-107778",
              "name": "OsPackageVulnerability",
              "shortDescription": {
                "text": "krb5: krb5: Denial of Service via crafted forwarded credentials"
              },
              "fullDescription": {
                "text": "MIT Kerberos 5 (krb5) through 1.22.2 contains a NULL pointer dereference in make_cred_list() in rd_cred.c that allows authenticated Kerberos clients to crash services by sending mismatched KRB-CRED arrays. Attackers can send forwarded credentials with more tickets than ticket_info entries through gss_accept_sec_context() to crash GSS-API acceptor services, causing denial of service."
              },
              "defaultConfiguration": {
                "level": "warning"
              },
              "helpUri": "https://avd.aquasec.com/nvd/cve-2026-107778",
